# Copy to .env before `docker compose up -d`.

# Moodle git tag to build from (v4.5.x is LTS).
MOODLE_TAG=v4.5.0

MOODLE_WWWROOT=http://localhost:8380
MOODLE_USERNAME=admin
MOODLE_PASSWORD=Admin1234!
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=local_weekopener Dev

MARIADB_ROOT_PASSWORD=rootsecret
MARIADB_DATABASE=moodle
MARIADB_USER=moodle
MARIADB_PASSWORD=moodlepass
